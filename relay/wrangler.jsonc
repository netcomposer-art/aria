{
  // ARIA's phone remote relay (netcomposer-art/aria relay/). Deployed to nc-remote.<account>.workers.dev.
  // One Durable Object per pairing room; it only passes messages between the two sockets. Nothing is stored.
  "name": "nc-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Pages allowed to open a socket (the WebSocket Origin header). Local dev adds http://127.0.0.1 and localhost.
    "ALLOWED_ORIGINS": "https://netcomposer.art"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RemoteRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RemoteRoom"] }],
  // Burst guard on new sockets per address. Wrangler accepts period 10 or 60 (seconds).
  "ratelimits": [
    { "name": "CONNECT_RATE", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }
  ]
}
